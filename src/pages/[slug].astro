---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import UspGrid from '../components/UspGrid.astro';
import ServiceList from '../components/ServiceList.astro';
import AreaChips from '../components/AreaChips.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { areas } from '../data/areas';

export async function getStaticPaths() {
  const niches = await getCollection('niches');
  return niches.map((n) => ({
    params: { slug: n.data.urlSlug },
    props: { niche: n },
  }));
}

const { niche } = Astro.props;
const d = niche.data;

const localityKeywords = areas.slice(0, 30).map((a) => `${d.name} in ${a}`);
const searchKeywords = [...d.keywords, ...localityKeywords];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: d.name,
    areaServed: 'Vadodara, Gujarat',
    provider: {
      '@type': 'LocalBusiness',
      name: 'Vadodara Experts',
      image: 'https://vadodaraexperts.com/android-chrome-512x512.png',
      telephone: '+91-6353583148',
      priceRange: '₹₹',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '104, Silver Business Point, Alkapuri',
        addressLocality: 'Vadodara',
        addressRegion: 'Gujarat',
        postalCode: '390007',
        addressCountry: 'IN',
      },
    },
    description: d.descriptions[0],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vadodaraexperts.com/' },
      { '@type': 'ListItem', position: 2, name: d.name, item: `https://vadodaraexperts.com/${d.urlSlug}` },
    ],
  },
];
---
<BaseLayout title={d.titles[0]} description={d.descriptions[0]} path={`/${d.urlSlug}/`} jsonLd={jsonLd}>
  <Hero eyebrow={d.eyebrow} heading={d.titles[0].split('|')[0].trim()} sub={d.heroSub} niche={d.name} services={d.services} bgImage={`/images/${d.urlSlug}.jpg`} />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>{d.aboutHeading}</h2>
      </div>
      <div class="about-copy">
        {d.aboutParagraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Why Vadodara Experts</h2>
        <p>What you get when you book {d.name.toLowerCase()} in Vadodara through us:</p>
      </div>
      <UspGrid usps={d.usps} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Services covered</h2>
        <p>What's typically included under {d.name.toLowerCase()} in Vadodara:</p>
      </div>
      <ServiceList services={d.services} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>What affects the price</h2>
        <p>{d.costIntro}</p>
      </div>
      <ServiceList services={d.costFactors} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Areas we serve</h2>
      </div>
      <AreaChips niche={d.name.toLowerCase()} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>How it works</h2>
      </div>
      <div class="grid grid-3 steps">
        <div class="card step">
          <span class="step-no">1</span>
          <p class="step-title">Send your requirement</p>
          <p>Fill the quick form above with your name, number and what you need.</p>
        </div>
        <div class="card step">
          <span class="step-no">2</span>
          <p class="step-title">We review your requirement</p>
          <p>Our team goes through your {d.name.toLowerCase()} requirement in Vadodara and gets back to you directly.</p>
        </div>
        <div class="card step">
          <span class="step-no">3</span>
          <p class="step-title">We get it done</p>
          <p>We confirm the schedule and pricing on WhatsApp, then get to work on your {d.name.toLowerCase()} requirement.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Frequently asked questions</h2>
      </div>
      <FaqAccordion faqs={d.faqs} />
    </div>
  </section>

  <section class="section kw-section">
    <div class="container">
      <p class="kw-label">Popular searches</p>
      <p class="kw-line">{searchKeywords.join(' · ')}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .about-copy{ display:flex; flex-direction:column; gap:16px; max-width:74ch; }
  .about-copy p{ font-size:.98rem; }
  .steps{ align-items:stretch; }
  .step{ padding:24px 22px; position:relative; }
  .step-no{
    display:inline-flex; align-items:center; justify-content:center;
    width:28px; height:28px; border-radius:50%;
    background:var(--accent-soft); color:var(--accent);
    font-weight:600; font-size:.85rem; margin-bottom:12px;
  }
  .step-title{ font-weight:600; color:var(--ink); margin-bottom:6px; }

  .kw-section{ padding:32px 0 48px; }
  .kw-label{
    font-size:.7rem; text-transform:uppercase; letter-spacing:.06em;
    color:var(--ink-soft); margin-bottom:8px;
  }
  .kw-line{ font-size:.8rem; color:var(--ink-soft); line-height:1.9; opacity:.85; }
</style>
